    "sea_level_molecular_weight": { "number": "21", "page": 9, "form": "M = M0 = Σ(F_i·M_i)/ΣF_i" },
    "molecular_scale_temperature": { "number": "22", "page": 9, "form": "T_M = T·M0/M, so the kinetic temperature is T = T_M·M/M0" },
    "molecular_scale_temperature_profile": { "number": "23", "page": 10, "form": "T_M = T_M,b + L_M,b·(H - H_b)" },
