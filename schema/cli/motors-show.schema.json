{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MotorShow",
  "description": "`hpr motors show`: each motor's figures, worked out from its thrust curve.",
  "type": "object",
  "properties": {
    "motors": {
      "description": "The motors found: every catalog match for a name, or every motor in a file.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MotorFigures"
      }
    },
    "warnings": {
      "description": "What the reader accepted with a caveat, in file order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      }
    }
  },
  "required": [
    "motors",
    "warnings"
  ],
  "$defs": {
    "Delay": {
      "description": "One ejection delay setting.",
      "oneOf": [
        {
          "description": "The ejection charge fires this many seconds after burnout.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "seconds"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "No ejection charge: the forward closure is plugged.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugged"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "A `0`: the RASP format means a charge at burnout, but most files mean plugged.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "zero_or_plugged"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "FileFormat": {
      "description": "A motor file format.",
      "oneOf": [
        {
          "description": "RASP `.eng`.",
          "type": "string",
          "const": "eng"
        },
        {
          "description": "RockSim `.rse`.",
          "type": "string",
          "const": "rse"
        }
      ]
    },
    "MotorFigures": {
      "description": "One motor's figures, worked out by hpr from its thrust curve.",
      "type": "object",
      "properties": {
        "average_thrust_n": {
          "description": "Average thrust, N: total impulse over the burn time.",
          "type": "number",
          "format": "double"
        },
        "burn_end_s": {
          "description": "When the NFPA 1125 burn ends, s.",
          "type": "number",
          "format": "double"
        },
        "burn_start_s": {
          "description": "When the NFPA 1125 burn starts, s.",
          "type": "number",
          "format": "double"
        },
        "burn_time_s": {
          "description": "Burn time, s, by NFPA 1125: from when thrust first reaches 5% of its peak to when it last\nfalls to it.",
          "type": "number",
          "format": "double"
        },
        "curve_end_s": {
          "description": "The curve's last time, s.",
          "type": "number",
          "format": "double"
        },
        "delays": {
          "description": "The ejection delays offered.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Delay"
          }
        },
        "diameter_m": {
          "description": "Casing diameter, m.",
          "type": "number",
          "format": "double"
        },
        "impulse_class": {
          "description": "The impulse class the total impulse falls in, such as `J`.",
          "type": "string"
        },
        "length_m": {
          "description": "Casing length, m.",
          "type": "number",
          "format": "double"
        },
        "loaded_mass_kg": {
          "description": "Loaded motor mass, kg.",
          "type": "number",
          "format": "double"
        },
        "manufacturer": {
          "description": "The manufacturer, as the catalog or the file writes it.",
          "type": "string"
        },
        "name": {
          "description": "The motor's name: the catalog's designation, or the file's.",
          "type": "string"
        },
        "peak_thrust_n": {
          "description": "Peak thrust, N: the curve's largest point.",
          "type": "number",
          "format": "double"
        },
        "propellant_mass_kg": {
          "description": "Propellant mass, kg.",
          "type": "number",
          "format": "double"
        },
        "source": {
          "description": "Where the motor and its curve come from.",
          "$ref": "#/$defs/MotorSource"
        },
        "stated": {
          "description": "ThrustCurve.org's stated figures, for a catalog motor.",
          "anyOf": [
            {
              "$ref": "#/$defs/StatedFigures"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_impulse_ns": {
          "description": "Total impulse, N·s: the thrust curve's area, joining its points with straight lines.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "manufacturer",
        "source",
        "diameter_m",
        "length_m",
        "propellant_mass_kg",
        "loaded_mass_kg",
        "total_impulse_ns",
        "impulse_class",
        "average_thrust_n",
        "peak_thrust_n",
        "burn_time_s",
        "burn_start_s",
        "burn_end_s",
        "curve_end_s",
        "delays"
      ]
    },
    "MotorSource": {
      "description": "Where a motor comes from.",
      "oneOf": [
        {
          "description": "The bundled catalog, with a public-domain curve from ThrustCurve.org.",
          "type": "object",
          "properties": {
            "curve_url": {
              "description": "The curve file's ThrustCurve.org page.",
              "type": "string"
            },
            "format": {
              "description": "The curve's format: `eng` or `rse`.",
              "$ref": "#/$defs/FileFormat"
            },
            "kind": {
              "type": "string",
              "const": "catalog"
            }
          },
          "required": [
            "kind",
            "curve_url",
            "format"
          ]
        },
        {
          "description": "A motor file named on the command line.",
          "type": "object",
          "properties": {
            "format": {
              "description": "The file's format: `eng` or `rse`.",
              "$ref": "#/$defs/FileFormat"
            },
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "description": "The path as given.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "format"
          ]
        }
      ]
    },
    "StatedFigures": {
      "description": "ThrustCurve.org's stated figures for a catalog motor, to set beside hpr's.",
      "type": "object",
      "properties": {
        "average_thrust_n": {
          "description": "Average thrust, N.",
          "type": "number",
          "format": "double"
        },
        "burn_time_s": {
          "description": "Burn time, s.",
          "type": "number",
          "format": "double"
        },
        "impulse_class": {
          "description": "The impulse class.",
          "type": "string"
        },
        "max_thrust_n": {
          "description": "Peak thrust, N, where stated.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "total_impulse_ns": {
          "description": "Total impulse, N·s.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "impulse_class",
        "total_impulse_ns",
        "average_thrust_n",
        "burn_time_s"
      ]
    },
    "Warning": {
      "description": "Something a reader accepted with a caveat.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "How serious it is.",
          "$ref": "#/$defs/WarningKind"
        },
        "line": {
          "description": "The 1-based line in the file, when it is about one.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "message": {
          "description": "What was found, and how it was read.",
          "type": "string"
        },
        "motor": {
          "description": "The motor it is about, when it is about one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    "WarningKind": {
      "description": "How serious a warning is.",
      "oneOf": [
        {
          "description": "A whole motor had an error and was left out.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "A value was dropped or ignored.",
          "type": "string",
          "const": "dropped"
        },
        {
          "description": "Something unusual was read as it stands.",
          "type": "string",
          "const": "unusual"
        }
      ]
    }
  }
}
