# Check out text files with LF on every OS, so rustfmt, snapshot tests and reference-data hashes
# behave the same on Windows as on macOS and Linux.
* text=auto eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.ork binary
*.gz binary

# Bundled ThrustCurve.org curves keep the exact bytes the site serves (mostly CRLF, no final
# newline); crates/hpr-motor/data/thrustcurve/catalog.json pins their sha256.
crates/hpr-motor/data/thrustcurve/curves/** -text
